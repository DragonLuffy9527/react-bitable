{
  "name": "react-bitable",
  "version": "0.1.0",
  "description": "类飞书多维表格的 React 组件库：一份数据，六种视图（表格 / 看板 / 画册 / 甘特 / 日历 / 表单），支持字段配置、筛选、排序、多级分组、条件染色、行内编辑与 localStorage 持久化。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "bitable",
    "table",
    "datagrid",
    "kanban",
    "gantt",
    "calendar",
    "gallery",
    "data-grid",
    "low-code",
    "headless-ui",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DragonLuffy9527/react-bitable.git"
  },
  "homepage": "https://github.com/DragonLuffy9527/react-bitable#readme",
  "bugs": {
    "url": "https://github.com/DragonLuffy9527/react-bitable/issues"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
